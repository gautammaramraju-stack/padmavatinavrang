{
  "name": "zaykawrap-app",
  "version": "1.0.0",
  "description": "Padmavati Navrang ZaykaWrap Mobile App",
  "main": "index.js",
  "scripts": {
    "build": "echo 'Build complete. Use Capacitor to sync and build native apps.'",
    "sync": "npx cap sync",
    "android": "npx cap open android",
    "ios": "npx cap open ios",
    "build:android": "npx cap sync && cd android && ./gradlew assembleRelease",
    "build:ios": "npx cap sync && echo 'Open Xcode and build from there'"
  },
  "keywords": [
    "zaykawrap",
    "aluminium-foil",
    "pwa",
    "mobile-app"
  ],
  "author": "Padmavati Navrang",
  "license": "MIT",
  "dependencies": {
    "@capacitor/core": "^5.5.0",
    "@capacitor/app": "^5.0.6",
    "@capacitor/haptics": "^5.0.6",
    "@capacitor/keyboard": "^5.0.6",
    "@capacitor/status-bar": "^5.0.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.5.0",
    "@capacitor/android": "^5.5.0",
    "@capacitor/ios": "^5.5.0"
  }
}
